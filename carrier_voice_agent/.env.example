# ---------------------------------------------------------------------------
# Copy this file to ".env" and fill in your values. NEVER commit the real .env.
# ---------------------------------------------------------------------------

# --- LiveKit (required) — https://cloud.livekit.io -> project -> Settings -> Keys
LIVEKIT_URL=wss://your-project-xxxx.livekit.cloud
LIVEKIT_API_KEY=APIxxxxxxxxxxxx
LIVEKIT_API_SECRET=your-livekit-api-secret

# --- Groq (required) — https://console.groq.com  (free tier)
GROQ_API_KEY=gsk_your_new_key

# --- Models (optional; defaults in src/lanevoice/settings.py) --------------
# STT_MODEL=whisper-large-v3-turbo
# LLM_MODEL=llama-3.1-8b-instant          # or llama-3.3-70b-versatile
# TTS_MODEL=canopylabs/orpheus-v1-english   # playai-tts was shut down 2025-12-31
# TTS_VOICE=troy                             # voices: troy, autumn, diana, hannah, austin, daniel

# --- Behavior (optional) ---------------------------------------------------
# USE_LLM=1                               # phrase replies via the LLM (else templates)
# MIN_ENDPOINTING_DELAY=0.8               # seconds to wait after caller stops
# MAX_ENDPOINTING_DELAY=8.0
# MAX_NEGOTIATION_ROUNDS=8
# NEGOTIATION_BUFFER=0                    # reserve held below Max Buy (0 = may reach it)
# NEGOTIATION_RECIPROCITY=0.5             # share of the carrier's own drop we give back
# NEGOTIATION_DISCRETION_RATE=0.6         # how far up floor->Max Buy the bot commits alone
#                                         #   (above that, inside Max Buy -> hand to a rep;
#                                         #    1.0 = bot owns the whole range)
# NEGOTIATION_SETTLE_GAP_RATE=0.10        # gap not worth haggling over -> just book it
# NEGOTIATION_SPLIT_GAP_RATE=0.30         # gap close enough to play the split-and-book close
# NEGOTIATION_STONEWALL_FINAL_RATE=0.5    # best-and-final for a carrier who never moved
# NEGOTIATION_MAX_HOLDS=2                 # times to ask the carrier to come down before best-and-final
# DB_PATH=carrier_agent.db
# LOG_LEVEL=INFO
