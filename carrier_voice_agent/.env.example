# ---------------------------------------------------------------------------
# Copy this file to ".env" (same folder) and paste your real values in.
# The worker and the `lk` CLI both read these. NEVER commit the real .env.
# ---------------------------------------------------------------------------

# --- LiveKit (required) — from https://cloud.livekit.io -> your project ---
# Settings -> Keys.  URL starts with wss://
LIVEKIT_URL=wss://your-project-xxxx.livekit.cloud
LIVEKIT_API_KEY=APIxxxxxxxxxxxx
LIVEKIT_API_SECRET=your-livekit-api-secret

# --- Twilio (required for the phone number) — from https://console.twilio.com ---
# The WORKER itself does not use these; they're for the Twilio console / CLI
# setup and any future outbound work. Kept here so all secrets live in one place.
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your-twilio-auth-token
TWILIO_PHONE_NUMBER=+1XXXXXXXXXX

# --- Optional ---
# HF_TOKEN=hf_xxxxxxxx          # only if you swap in a GATED model (Llama etc.)
# FMCSA_WEBKEY=xxxxxxxx         # only to replace the mock carrier verification

# --- Voice tuning ---
# Faster STT on CPU (recommended for phone calls) — re-run download_models.py after changing:
# WHISPER_SIZE=tiny.en
# Turn-taking buffer (seconds). Bigger = caller can pause longer without being cut off:
# MIN_ENDPOINTING_DELAY=1.5
# MAX_ENDPOINTING_DELAY=8.0
# TTS_ENGINE=edge              # edge | pyttsx3 (offline) | kokoro (linux)
