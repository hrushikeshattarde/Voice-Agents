# Secrets — NEVER commit these.
# The real .env holds the LiveKit API secret, the Groq key and the Transport Pro
# production password. `carrier_voice_agent/.gitignore` covers a .env inside that
# directory, which is not the same file as this one at the repo root — the root
# needs its own rule, and lacking it is how a credential reaches GitHub.
# .env.example is the template and is meant to be tracked.
.env
.env.*
!.env.example

# Python-generated files
__pycache__/
*.py[oc]
build/
dist/
wheels/
*.egg-info

# Virtual environments
.venv

# Local databases — the call audit trail holds real transcripts and rates.
*.db
*.sqlite
*.sqlite3

# Tooling caches
.pytest_cache/
.ruff_cache/
.mypy_cache/
