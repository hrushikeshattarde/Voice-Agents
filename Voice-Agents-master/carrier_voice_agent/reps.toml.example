# The rep directory — OPTIONAL. A handoff goes to the load's carrier sales rep
# as Transport Pro lists them (`internalContacts` on the load, name and number
# from the user record), with no entry here. This file OVERRIDES that: use the
# rep's Transport Pro user id as `id` to give them a direct line or 8x8 DID when
# Transport Pro only has the office main line with an extension (which a SIP
# transfer cannot dial through), or to mark them unavailable. Entries with
# other ids are the fallback pool for a load with no rep of its own.
#
# Copy this file to `reps.toml` next to the database (or point REPS_FILE at it).
# The worker and the dashboard reload it at every start; the file is the source
# of truth for the `reps` table.
#
# With no file, the agent never invents a name: a rep with no diallable number is
# named and promised as a callback, and a load with no rep at all gets "a rep
# will call you back", logged on the call record.
#
# `available = false` keeps somebody in the directory without routing calls to
# them (out sick, on leave). All of `id`, `name` and `phone` are required.
#
# `email` is likewise optional and likewise an override: Transport Pro's own
# user record already carries one (`emailContacts`), read straight off it with
# no entry here. Set it only to redirect the post-call summary somewhere else
# (a shared inbox, a rep whose TP record has no address on file).
#
# [[reps]]
# id = "jsmith"
# name = "Jordan Smith"
# phone = "+12605551234"
# available = true
# email = "jordan.smith@example.com"
#
# [[reps]]
# id = "alee"
# name = "Alex Lee"
# phone = "+12605555678"
# available = false
