# ---------------------------------------------------------------------------
# Copy this file to ".env" and fill in your values. NEVER commit the real .env.
# ---------------------------------------------------------------------------

# --- LiveKit (required) — https://cloud.livekit.io -> project -> Settings -> Keys
LIVEKIT_URL=wss://your-project-xxxx.livekit.cloud
LIVEKIT_API_KEY=APIxxxxxxxxxxxx
LIVEKIT_API_SECRET=your-livekit-api-secret

# --- OpenRouter (always required) — https://openrouter.ai/keys
# All three AI hops run here: speech-to-text, the LLM that writes each spoken
# turn, and the voice that says it. This is the only AI key a stock deploy needs.
OPENROUTER_API_KEY=sk-or-v1-...

# --- Which LLM writes the agent's spoken turns ------------------------------
#   openrouter Claude Haiku 4.5 via OpenRouter's OpenAI-compatible gateway.
#              The default — the key above already covers it.
#   anthropic  The same model via the official SDK, one hop fewer. Needs
#              ANTHROPIC_API_KEY *as well*, since speech still goes to OpenRouter.
# Only the composer moves — STT and TTS are always OpenRouter.
LLM_PROVIDER=openrouter

# Only needed for LLM_PROVIDER=anthropic.
# ANTHROPIC_API_KEY=sk-ant-...

# Pin a model, or leave unset to take the provider's default:
#   openrouter -> anthropic/claude-haiku-4.5   (200K ctx, $1/$5 per MTok)
#   anthropic  -> claude-haiku-4-5             (same model, same price, one hop fewer)
# LLM_MODEL=
# LLM_TIMEOUT=20.0                        # a carrier is on the line; fail fast
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# --- Where loads and carriers come from ------------------------------------
# transportpro = the live Transport Pro Public API (the three below are required)
# sqlite       = the offline seed data, for `lanevoice-demo` and the test suite
DATA_SOURCE=transportpro

# --- Transport Pro (required when DATA_SOURCE=transportpro) ----------------
# URL is the API root that the Postman collection calls {{URL}} — everything
# below is appended to it (/auth, /voiceai/..., /contact/search).
TRANSPORT_PRO_URL=https://your-tenant.transportpro.net/publicapi
TRANSPORT_PRO_USERNAME=apiuser_yourname
TRANSPORT_PRO_PASSWORD=your-api-password

# --- Which office's freight may this deployment sell? -----------------------
# EMPTY = the whole company board. Set to an office's terminalCode and the agent
# may only quote and book that office's loads — the office terminal PLUS every POD
# and team parented under it.
#
# Fort Wayne Office is code "1001" (id 1003). The subtree is the whole point:
# measured on the live tenant, the office terminal itself holds 4 posted loads
# while its 49 PODs hold another 338, so scoping to the office alone would hide
# 99% of its own freight while looking like it worked.
# TRANSPORT_PRO_OFFICE_TERMINAL_CODE=1001

# Manual pin of terminal IDS (not codes), comma-separated. Bypasses the tree walk
# entirely — for a scope that isn't a clean subtree, or to keep the filter working
# if /terminal/search is unavailable.
# TRANSPORT_PRO_OFFICE_TERMINAL_IDS=

# Terminal ids ADDED to the walked subtree. For testing against a load parked
# outside the office tree, which would otherwise be correctly rejected.
# Leave unset in production.
# TRANSPORT_PRO_EXTRA_TERMINAL_IDS=
# TEST_LOAD_IDS=                          # rehearsal loads: treated as this desk's, posted
#                                         #   and open whatever Transport Pro says, so a
#                                         #   whole call (notes included) can be tried on a
#                                         #   dummy load. Leave EMPTY on a production desk.

# A load whose terminal can't be read is OUT of scope by default — "this office's
# loads only" means an unattributable load must not be assumed ours. Turn on only
# while checking field names against live data.
# TRANSPORT_PRO_ALLOW_UNKNOWN_TERMINAL=0
# TRANSPORT_PRO_TERMINAL_CACHE_SECONDS=3600   # org structure, not freight

# --- Transport Pro tuning (optional) ---------------------------------------
# The ONLY load statuses the agent will sell. A load must be in one of these AND
# have posting switched on (postingInfo.isPosted) before it is offered.
# Comma-separated; case and punctuation are normalised.
#   Verified against the live tenant: /load/{id} and /load/search both return
#   "Ready To Dispatch", so the default is correct. If a board ever looks full but
#   the agent offers nothing, run `lanevoice-tpcheck --load <id> --raw` — it prints
#   the status it actually saw — and add that value here.
# TRANSPORT_PRO_OPEN_LOAD_STATUSES=ready to dispatch
# TRANSPORT_PRO_TIMEOUT=10.0                # a carrier is holding the line
# TRANSPORT_PRO_FRAUD_LOW_RATIO=0.5         # ask below this share of the board
#                                           #   rate -> fraud review, not a booking
# TRANSPORT_PRO_MAX_OFFERED_LOADS=5         # load numbers read out when theirs misses
# TRANSPORT_PRO_MAX_SEARCH_PAGES=10         # /load/search pages at 200 rows and
#                                           #   `perPage` is ignored. This is the
#                                           #   runaway backstop (= 2000 loads), not
#                                           #   a target: the board scan stops as
#                                           #   soon as it has enough to read out.
# TRANSPORT_PRO_OPEN_LOAD_DAYS=7            # pickup window /load/search looks ahead
# TRANSPORT_PRO_LOAD_CACHE_SECONDS=60       # a load can be covered mid-call
# TRANSPORT_PRO_CARRIER_CACHE_SECONDS=300   # vetting status doesn't move
# TRANSPORT_PRO_REQUIRE_INSURANCE_FIELD=0   # turn on once carrier_status is known
#                                           #   to report insurance; then a missing
#                                           #   insurance field becomes a hard stop
# POST_LOAD_NOTES=1                         # mirror call notes onto the load

# --- Highway (optional) — carrier qualifications + cargo insurance ----------
# Transport Pro's carrier_status carries NO classification list, so without this
# the agent cannot tell whether a carrier may haul a load that demands Critical
# Cargo. Highway's rules_assessment is authoritative BOTH ways: a "pass" clears a
# carrier Transport Pro's list omitted, a "fail" rejects one it wrongly claimed.
# Also supplies the trading name for the read-back — Transport Pro often returns
# the owner's personal name where Highway has the company.
# Absent = the checks are skipped, loudly, at worker startup.
# HIGHWAY_API_TOKEN=eyJ...          # a JWT with a HARD EXPIRY, not a static key
# HIGHWAY_API_URL=https://highway.com/core/connect/external_api/v1/carriers
# HIGHWAY_TIMEOUT=8.0               # shorter than TP: a slow Highway is worse
#                                   #   than none, the fallback is usable
# HIGHWAY_PREFER_COMPANY_NAME=1     # 0 keeps Transport Pro's carrier_name

# --- Transport Pro "HappyRobot" endpoint (optional) -------------------------
# Same host as TRANSPORT_PRO_URL, different path, different auth (a static token,
# not the /auth login). The ONLY route to two things publicapi lacks:
#   accept_offer   -> the booking link the carrier opens to sign
#   invite_carrier -> the Highway connect invite for a PASS carrier
# Absent = an agreed rate is LOGGED as an offer for a rep to action, and no call
# can end in the carrier actually holding the load.
# HAPPYROBOT_URL=https://cli.transportpro.net/svc/happyrobot.php
# HAPPYROBOT_TOKEN=
# HAPPYROBOT_TIMEOUT=15.0
# Offer attribution. NOT interchangeable: send_offer rejects 4876 outright with
# "tp_user_id invalid or inactive", and only the REST /offer path accepts it.
# TRANSPORT_PRO_BOOKING_USER_ID=4876     # "API BookMateAI"      -> real booking
# TRANSPORT_PRO_LOG_OFFER_USER_ID=4236   # "Happy Robot Chicago" -> log-only

# --- Speech on the phone line (optional; defaults are the streaming path) ----
# Which service hears the caller, and which one speaks. Both default to LiveKit
# Inference: streaming over WebSockets on the LiveKit credentials above, no extra
# key, billed on the LiveKit account. Transcription runs WHILE the caller talks
# and the voice starts on its first few hundred milliseconds of audio.
# `openrouter` is the original batch path — one Whisper POST per utterance after
# the caller stops, a voice that generates the whole reply before its first
# byte — kept as the fallback, and still what practice mode uses (STT_MODEL /
# TTS_MODEL below). Measured before the switch: 35-48% of a call was silence.
# STT_PROVIDER=inference
# STT_INFERENCE_MODEL=assemblyai/u3-rt-pro   # universal-streaming lost first words;
#                                            #   deepgram/nova-3 also works. All
#                                          #   stream and take the freight keyterm
#                                          #   list. AssemblyAI is the default for
#                                          #   how it writes numbers (settings.py)
# STT_KEYTERMS=                            # extra vocabulary, comma-separated, ADDED
#                                          #   to the built-in list in worker.py
# TTS_PROVIDER=inference
# TTS_INFERENCE_MODEL=cartesia/sonic-3     # see settings.py for the voice default
# TTS_INFERENCE_VOICE=                     # a NAMED voice the model offers. Required
#                                          #   to be fixed so the agent is one person
#                                          #   all call; a wrong one fails at worker
#                                          #   start (prewarm), never on a call.
#   Audition Inference voices by ear and first-audio latency:
#     uv run python tools/audition_voices.py --inference

# --- OpenRouter speech models (optional; defaults in src/lanevoice/settings.py)
# Practice mode always uses these; the phone line uses them only when a
# provider above is set to `openrouter`. Both are OpenRouter slugs, so they are
# vendor-namespaced. LLM_MODEL / LLM_PROVIDER are set further up.
#
# STT_MODEL=openai/whisper-large-v3        # openai/whisper-large-v3-turbo also
#                                          #   exists but costs ~25x per minute
# The agent must sound like ONE PERSON, and must not leave the caller in silence.
# Both requirements are why this is mai-voice-2-flash: it takes a stable NAMED voice
# and synthesises at ~0.1x real time. fish-audio was the original pick and is the
# bug that replaced it — it rejects `voice` entirely (identity comes from cloning)
# and its provider-side default is NOT stable, so the speaker changed between turns
# of the same call.
#
# Measured on one identical load pitch, fastest first:
#   microsoft/mai-voice-2-flash  1.1s  0.08x  named voice   <- default
#   hexgrad/kokoro-82m           0.7s  0.05x  named voice (am_adam / am_michael)
#   fish-audio/s2.1-pro-free     3.1s  0.26x  NO NAMED VOICE — do not use
#   deepgram/aura-2              5.5s  0.47x  named voice
#   deepgram/flux-tts:free       6.4s  0.59x  36 named voices, and the only
#                                             provider that will list them
# TTS_MODEL=microsoft/mai-voice-2-flash
# TTS_VOICE=en-US-Ethan:MAI-Voice-2        # male. Harper is the female one; of 30
#                                          #   plausible names probed, only those
#                                          #   two exist on this model.
#   Compare by ear and by latency:
#     uv run python tools/audition_voices.py
#     uv run python tools/audition_voices.py --deepgram-voices
# TTS_SAMPLE_RATE=24000                    # fallback only; the real rate is read
#                                          #   off the response Content-Type. It
#                                          #   DOES vary: MAI and Deepgram answer
#                                          #   24000, fish-audio 44100 — assuming
#                                          #   one plays the other at 54% speed.
# TTS_TIMEOUT=15.0                         # a hung TTS call is dead air

# --- Deadhead (optional) ----------------------------------------------------
# The agent estimates how far the caller's empty truck is from the pickup and
# mentions it in the pitch ("it's about ninety miles from you"). Pickup coords
# come off the load; the caller's city is resolved against a bundled US table, so
# there is no geocoding call and no key.
# Measured 3-15% OVER real driving miles on five known routes (mean 8.8%) — over
# is the safe direction. Always spoken rounded. Never touches a rate.
# DEADHEAD_ROAD_FACTOR=1.2      # driving miles / straight-line miles

# --- Behavior (optional) ---------------------------------------------------
# USE_LLM=1                               # phrase replies via the LLM (else templates)
# MIN_ENDPOINTING_DELAY=1.0               # wait after the caller stops when the turn
#                                         #   detector reads them as finished; was 1.3
#                                         #   under batch Whisper, whose round trip hid it,
#                                         #   and 0.7 clipped a caller mid-sentence live
# MAX_ENDPOINTING_DELAY=3.0               # ...and when it reads them as mid-thought
# MIN_INTERRUPTION_DURATION=0.9           # continuous speech before it counts as barge-in
# MIN_INTERRUPTION_WORDS=2                # words heard before it counts — a one-word
#                                         #   "yeah" no longer cuts the pitch (0 = off)
# UNHEARD_REASK_DELAY=4.5                 # caller heard speaking but nothing transcribed
#                                         #   for this long -> "say that one more time?"
#                                         #   (must exceed MAX_ENDPOINTING_DELAY; 0 = off)
# STT_COMFORT_NOISE_DBFS=-55              # whisper of noise fed to the recogniser only,
#                                         #   so it doesn't doze off in the caller's
#                                         #   silences and clip their next words (0 = off)
# MAX_NEGOTIATION_ROUNDS=8
# NEGOTIATION_BUFFER=0                    # reserve held below Max Buy (0 = may reach it)
# NEGOTIATION_RECIPROCITY=0.5             # share of the carrier's own drop we give back
# NEGOTIATION_DISCRETION_RATE=0.6         # how far up floor->Max Buy the bot commits alone
#                                         #   (above that, inside Max Buy -> hand to a rep;
#                                         #    1.0 = bot owns the whole range)
# NEGOTIATION_SETTLE_GAP_RATE=0.10        # gap not worth haggling over -> just book it
# NEGOTIATION_SPLIT_GAP_RATE=0.30         # gap close enough to play the split-and-book close
# NEGOTIATION_STONEWALL_FINAL_RATE=0.5    # best-and-final for a carrier who never moved
# NEGOTIATION_MAX_HOLDS=2                 # times to ask the carrier to come down before best-and-final
# DB_PATH=carrier_agent.db
# REPS_FILE=reps.toml                     # optional overrides for the reps a load names
#                                         #   in Transport Pro (a direct number, an
#                                         #   availability flag), keyed on TP user id —
#                                         #   see reps.toml.example. Relative = next to
#                                         #   the database. No sample reps are ever
#                                         #   written to a live database.
# SIP_TRANSFER_ENABLED=0                  # 1 = after announcing the handoff, REFER the
#                                         #   caller to the rep's number over the trunk
#                                         #   (needs Call Transfer + PSTN Transfer
#                                         #   enabled on the trunk — LIVE_SETUP.md B5).
#                                         #   0 = announce and log only (the default).
# LOG_LEVEL=INFO
